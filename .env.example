# ==============================================================================
# 3abaqira System - Environment Configuration Template (.env.example)
# ==============================================================================

# Database Engine Selection: 'sqlite' (default out-of-the-box), 'postgresql', or 'mysql'
DB_TYPE=sqlite

# SQLite Configuration (Used when DB_TYPE=sqlite)
DB_NAME=3abaqira_dev.db

# PostgreSQL Configuration (Uncomment and configure if using PostgreSQL)
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=abaqira_db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/abaqira_db

# MySQL Configuration (Uncomment and configure if using MySQL)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=root
# DB_NAME=abaqira_db

# Security & JWT Token Authentication
JWT_SECRET_KEY=3abaqira_super_secure_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=True
